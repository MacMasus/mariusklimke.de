[Unit]
Description=mariusklimke.de deploy (pull built branch + rsync into docroot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the `deploy` user: it owns /opt/http/mariusklimke.de (the same user
# the previous rsync-based deploy used).
User=deploy
ExecStart=/opt/mariusklimke-deploy/deploy.sh
StandardOutput=journal
StandardError=journal
